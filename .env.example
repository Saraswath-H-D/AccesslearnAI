# AccessLearn AI Configuration Environment File

# Application Settings
APP_NAME="AccessLearn AI"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# AI API Credentials (Optional - system falls back gracefully if not provided)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Redis & Celery Configuration (Optional - falls back to Python async background tasks)
REDIS_URL="redis://localhost:6379/0"

# YouTube cookies file (Optional - needed mainly on cloud hosts; YouTube
# bot-checks datacenter IPs even for public videos). Export cookies.txt from
# a browser logged into YouTube and point this at its path.
YTDLP_COOKIES_FILE=""

# Storage Directories
UPLOAD_DIR="./storage/uploads"
OUTPUT_DIR="./storage/outputs"
